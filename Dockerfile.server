# Pinned SSH lab server.
# The same file builds the vulnerable server and the patched twin.
# Dates are snapshot.debian.org timestamps whose bookworm suite contains
# the package versions below. Current Bookworm and Bullseye apt repositories
# already carry the Terrapin backport, so version numbers such as OpenSSH 9.2
# are not enough to identify a vulnerable build.

ARG DEBIAN_IMAGE=debian:bookworm-slim
ARG RUST_IMAGE=rust:1.83-slim

FROM ${DEBIAN_IMAGE} AS gitea-fetch
ARG GITEA_VERSION=1.21.0
ARG GITEA_SHA256=ff8aecf97f66f4a3ec55532f26716612457738b93f5f667124fdd6c59fddd735
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL --retry 5 --retry-delay 2 -o /tmp/gitea \
        "https://dl.gitea.com/gitea/${GITEA_VERSION}/gitea-${GITEA_VERSION}-linux-amd64" \
    && echo "${GITEA_SHA256}  /tmp/gitea" | sha256sum -c - \
    && chmod 0755 /tmp/gitea

FROM ${RUST_IMAGE} AS rust-builder
ARG RUSSH_VERSION=0.40.1
ENV RUSSH_CRATE_VERSION=${RUSSH_VERSION}
WORKDIR /src
COPY russh-project/ ./
RUN set -eux; \
    if [ "$RUSSH_VERSION" != "0.40.1" ]; then \
      sed -i "s/^russh = \"=0.40.1\"/russh = \"=${RUSSH_VERSION}\"/" Cargo.toml; \
      cargo update -p russh --precise "$RUSSH_VERSION"; \
      cargo build --release; \
    else \
      cargo build --release --locked; \
    fi

FROM ${DEBIAN_IMAGE}
ARG SNAPSHOT=20231115T000000Z
ARG OPENSSH_VERSION=1:9.2p1-2+deb12u1
ARG DROPBEAR_VERSION=2022.83-1
ARG GITEA_VERSION=1.21.0
ARG RUSSH_VERSION=0.40.1
ARG EXPECT_STRICT_KEX=no
ARG LAB_ROLE=vulnerable

ENV DEBIAN_FRONTEND=noninteractive \
    LAB_SSH_PASSWORD=TerrapinTest123! \
    LANG=C.UTF-8

# snapshot.debian.org often answers 503 while the timestamped archive is still
# published. apt-get update exits 0 in that case and the following install
# reports every package as missing. Retry until the pinned OpenSSH version
# is visible, then retry the deb download separately.
RUN set -eux; \
    rm -f /etc/apt/sources.list; \
    rm -rf /etc/apt/sources.list.d/* /var/lib/apt/lists/*; \
    mkdir -p /etc/apt/preferences.d /var/lib/apt/lists/partial; \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s bookworm main\n' "$SNAPSHOT" > /etc/apt/sources.list; \
    printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "3";\nAcquire::http::Timeout "30";\n' > /etc/apt/apt.conf.d/99snapshot; \
    printf 'Package: *\nPin: origin "snapshot.debian.org"\nPin-Priority: 1001\n' > /etc/apt/preferences.d/snapshot; \
    i=0; \
    until apt-get update -o APT::Update::Error-Mode=any \
      && apt-cache madison openssh-server | grep -F "$OPENSSH_VERSION"; do \
      i=$((i+1)); \
      if [ "$i" -ge 8 ]; then \
        echo "snapshot.debian.org did not return the bookworm index. HTTP 503 means the CDN has no healthy backend; the ${SNAPSHOT} archive is still published. Rerun this build."; \
        exit 1; \
      fi; \
      echo "snapshot index unavailable, retry ${i}"; \
      rm -rf /var/lib/apt/lists/*; \
      mkdir -p /var/lib/apt/lists/partial; \
      sleep $((15 * i)); \
    done; \
    i=0; \
    until apt-get install -y --no-install-recommends --allow-downgrades \
      "openssh-server=${OPENSSH_VERSION}" \
      "openssh-client=${OPENSSH_VERSION}" \
      "openssh-sftp-server=${OPENSSH_VERSION}" \
      "dropbear-bin=${DROPBEAR_VERSION}" \
      supervisor \
      git \
      sqlite3 \
      curl \
      ca-certificates \
      net-tools \
      iproute2 \
      iputils-ping \
      passwd \
    ; do \
      i=$((i+1)); \
      if [ "$i" -ge 6 ]; then exit 1; fi; \
      echo "apt-get install failed, retry ${i}"; \
      sleep $((15 * i)); \
    done; \
    apt-mark hold openssh-server openssh-client openssh-sftp-server dropbear-bin; \
    if [ "$EXPECT_STRICT_KEX" = "yes" ]; then \
      grep -a -q 'kex-strict-s-v00@openssh.com' /usr/sbin/sshd; \
      grep -a -q 'kex-strict-s-v00@openssh.com' /usr/sbin/dropbear; \
    else \
      if grep -a -q 'kex-strict' /usr/sbin/sshd; then echo "vulnerable sshd contains strict kex"; exit 1; fi; \
      if grep -a -q 'kex-strict' /usr/sbin/dropbear; then echo "vulnerable dropbear contains strict kex"; exit 1; fi; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /run/sshd /etc/dropbear /etc/russh /etc/gitea /var/lib/gitea/data /var/lib/gitea/log /var/log/supervisor; \
    id git >/dev/null 2>&1 || useradd -m -s /bin/sh git; \
    printf 'role=%s\nsnapshot=%s\nopenssh=%s\ndropbear=%s\ngitea=%s\nrussh=%s\nstrict_kex=%s\n' \
      "$LAB_ROLE" "$SNAPSHOT" "$OPENSSH_VERSION" "$DROPBEAR_VERSION" "$GITEA_VERSION" "$RUSSH_VERSION" "$EXPECT_STRICT_KEX" \
      > /etc/lab-release

COPY --from=gitea-fetch /tmp/gitea /usr/local/bin/gitea
COPY --from=rust-builder /src/target/release/russh-server /usr/local/bin/russh-server
COPY --from=rust-builder /src/target/release/russh-client /usr/local/bin/russh-client
COPY lab/entrypoint.sh /usr/local/bin/lab-entrypoint.sh
COPY lab/gitea-seed.sh /usr/local/bin/gitea-seed.sh
COPY lab/gitea/app.ini /etc/gitea/app.ini
COPY lab/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY lab/sshd_lab.conf /etc/ssh/sshd_config.d/lab.conf

RUN chmod 0755 /usr/local/bin/gitea /usr/local/bin/russh-server /usr/local/bin/russh-client \
      /usr/local/bin/lab-entrypoint.sh /usr/local/bin/gitea-seed.sh \
    && chown -R git:git /etc/gitea /var/lib/gitea

EXPOSE 22 2222 2223 2224 3000
ENTRYPOINT ["/usr/local/bin/lab-entrypoint.sh"]
