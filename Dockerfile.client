# Vulnerable OpenSSH client from the Bullseye snapshot on 2023-11-15.
# That archive still has openssh-client 1:8.4p1-5+deb11u2. The Terrapin
# backport arrived in 1:8.4p1-5+deb11u3, so a current bullseye-slim apt
# install is already patched.

ARG DEBIAN_IMAGE=debian:bullseye-slim
ARG RUST_IMAGE=rust:1.83-slim

FROM ${RUST_IMAGE} AS rust-builder
ENV RUSSH_CRATE_VERSION=0.40.1
WORKDIR /src
COPY russh-project/ ./
RUN cargo build --release --locked --bin russh-client

FROM ${DEBIAN_IMAGE}
ARG SNAPSHOT=20231115T000000Z
ARG OPENSSH_VERSION=1:8.4p1-5+deb11u2

ENV DEBIAN_FRONTEND=noninteractive \
    LAB_SSH_PASSWORD=TerrapinTest123! \
    LANG=C.UTF-8

# snapshot.debian.org often answers 503 while the timestamped archive is still
# published. apt-get update exits 0 in that case and the following install
# reports every package as missing. Retry until the pinned OpenSSH version
# is visible, then retry the deb download separately.
RUN set -eux; \
    rm -f /etc/apt/sources.list; \
    rm -rf /etc/apt/sources.list.d/* /var/lib/apt/lists/*; \
    mkdir -p /etc/apt/preferences.d /var/lib/apt/lists/partial; \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s bullseye main\n' "$SNAPSHOT" > /etc/apt/sources.list; \
    printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "3";\nAcquire::http::Timeout "30";\n' > /etc/apt/apt.conf.d/99snapshot; \
    printf 'Package: *\nPin: origin "snapshot.debian.org"\nPin-Priority: 1001\n' > /etc/apt/preferences.d/snapshot; \
    i=0; \
    until apt-get update -o APT::Update::Error-Mode=any \
      && apt-cache madison openssh-client | grep -F "$OPENSSH_VERSION"; do \
      i=$((i+1)); \
      if [ "$i" -ge 8 ]; then \
        echo "snapshot.debian.org did not return the bullseye index. HTTP 503 means the CDN has no healthy backend; the ${SNAPSHOT} archive is still published. Rerun this build."; \
        exit 1; \
      fi; \
      echo "snapshot index unavailable, retry ${i}"; \
      rm -rf /var/lib/apt/lists/*; \
      mkdir -p /var/lib/apt/lists/partial; \
      sleep $((15 * i)); \
    done; \
    i=0; \
    until apt-get install -y --no-install-recommends --allow-downgrades \
      "openssh-client=${OPENSSH_VERSION}" \
      git \
      rsync \
      curl \
      ca-certificates \
      net-tools \
      iproute2 \
      iputils-ping \
    ; do \
      i=$((i+1)); \
      if [ "$i" -ge 6 ]; then exit 1; fi; \
      echo "apt-get install failed, retry ${i}"; \
      sleep $((15 * i)); \
    done; \
    apt-mark hold openssh-client; \
    if grep -a -q 'kex-strict' /usr/bin/ssh; then echo "vulnerable ssh client contains strict kex"; exit 1; fi; \
    rm -rf /var/lib/apt/lists/*; \
    printf 'role=vulnerable-client\nsnapshot=%s\nopenssh-client=%s\nrussh-client=0.40.1\nstrict_kex=no\n' \
      "$SNAPSHOT" "$OPENSSH_VERSION" > /etc/lab-release

COPY --from=rust-builder /src/target/release/russh-client /usr/local/bin/russh-client
RUN chmod 0755 /usr/local/bin/russh-client

CMD ["sleep", "infinity"]
